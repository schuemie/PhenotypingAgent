# ============================================================================
# LLM Configuration for PhenotypingAgent
# ============================================================================
# Configure your LLM provider and model settings here. Copy this to .env
# and fill in your actual API credentials and model names.

# REASONING TIER (GPT-4o, Claude 3.5 Sonnet, etc.)
# Used for complex design iteration, Capr generation, and diagnostic reasoning
# ============================================================================

# Provider: 'openai', 'azure_openai', or 'anthropic'
REASONING_TIER_PROVIDER=openai

# Model name (must match your organization's available models)
# Examples:
#   - OpenAI: 'gpt-4o', 'gpt-4-turbo', 'gpt-4'
#   - Azure OpenAI: deployment name, e.g., 'gpt-4o-deployment'
#   - Anthropic: 'claude-3-5-sonnet-20241022', 'claude-3-opus-20240229'
REASONING_TIER_MODEL=gpt-4o

# FAST TIER (GPT-4o mini, Claude 3.5 Haiku, etc.)
# Used for quick expansions, concept set retrieval, and lightweight operations
# ============================================================================

# Provider: 'openai', 'azure_openai', or 'anthropic'
FAST_TIER_PROVIDER=openai

# Model name (fast, cost-effective models)
# Examples:
#   - OpenAI: 'gpt-4o-mini', 'gpt-3.5-turbo'
#   - Azure OpenAI: deployment name, e.g., 'gpt-4o-mini-deployment'
#   - Anthropic: 'claude-3-5-haiku-20241022'
FAST_TIER_MODEL=gpt-4o-mini

# ============================================================================
# OPENAI PROVIDER CREDENTIALS
# ============================================================================
# Required if using 'openai' provider for reasoning or fast tier

# API key from https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-...

# Optional: custom base URL for proxy/self-hosted endpoints
# OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================================================
# AZURE OPENAI PROVIDER CREDENTIALS
# ============================================================================
# Required if using 'azure_openai' provider for reasoning or fast tier

# API key from Azure Portal
AZURE_OPENAI_API_KEY=...

# Endpoint URL. Use the resource base, NOT the full chat-completions URL.
#   Correct:   https://your-resource.openai.azure.com
#   Also OK:   https://your-host/openai-chat
# A full deployment URL (https://.../openai/deployments/<name>/...) is accepted too: the
# /openai/deployments/... suffix is stripped automatically, since the client appends it itself.
# Leaving it in used to produce a doubled path and an opaque 404 "Resource not found".
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# Optional: API version (defaults to "2024-08-01")
AZURE_OPENAI_API_VERSION=2024-08-01

# Optional: deployment name fallback, used only when the tier model name is empty. The deployment
# embedded in AZURE_OPENAI_ENDPOINT is the last resort. AZURE_OPENAI_DEPLOYMENT is an alias.
# With Azure, set REASONING_TIER_MODEL / FAST_TIER_MODEL to your *deployment* names.
# AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name

# Note on reasoning models (o1/o3/o4*, gpt-5): they only accept default sampling settings, so
# `temperature` and `top_p` are omitted automatically for those models.

# ============================================================================
# ANTHROPIC PROVIDER CREDENTIALS
# ============================================================================
# Required if using 'anthropic' provider for reasoning or fast tier

# API key from https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-...

# ============================================================================
# USAGE EXAMPLES
# ============================================================================

# Example 1: Run with OpenAI (GPT-4o and GPT-4o mini)
# $ phenotyping-agent run \
#     --clinical-definition "acute liver failure.txt" \
#     --dry-run false

# Example 2: Run with Azure OpenAI
# $ phenotyping-agent run \
#     --clinical-definition "acute liver failure.txt" \
#     --dry-run false \
#     --reasoning-tier-provider azure_openai \
#     --reasoning-tier-model gpt-4o-deployment \
#     --fast-tier-provider azure_openai \
#     --fast-tier-model gpt-4o-mini-deployment

# Example 3: Run with Anthropic Claude
# $ phenotyping-agent run \
#     --clinical-definition "acute liver failure.txt" \
#     --dry-run false \
#     --reasoning-tier-provider anthropic \
#     --reasoning-tier-model claude-3-5-sonnet-20241022 \
#     --fast-tier-provider anthropic \
#     --fast-tier-model claude-3-5-haiku-20241022

# Example 4: Run with dry-run (fixture-backed models, no API keys needed)
# $ phenotyping-agent run \
#     --clinical-definition "acute liver failure.txt" \
#     --dry-run true

# ============================================================================
# ENVIRONMENT VARIABLE LOADING
# ============================================================================
# The agent automatically reads this .env file from the project root.
# To enable: pip install python-dotenv
# Add this to phenotyping_agent/__main__.py or cli.py initialization:
#   from dotenv import load_dotenv
#   load_dotenv()



